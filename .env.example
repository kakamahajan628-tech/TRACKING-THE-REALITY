# Copy to .env for local use. Set secrets in Render's Environment page when hosted.
TELEGRAM_BOT_TOKEN=
# Numeric private/group chat ID; only this chat can use commands.
TELEGRAM_CHAT_ID=
# Existing TRACKER-BOT deployments may keep TELEGRAM_TOKEN + USER_CHAT_ID instead.
# Use one complete pair. A nonempty modern pair takes precedence; pairs never mix.
# Private chat: owner inferred from chat ID. Groups: set your positive user ID.
TELEGRAM_OWNER_ID=
# Render supplies RENDER_EXTERNAL_URL automatically. Override only for a custom HTTPS domain.
PUBLIC_BASE_URL=
# Settings save locally by default. Render free local files are ephemeral.
CONTROL_STATE_FILE=runtime/control.json
# Optional durable settings: Upstash Redis REST URL and standard read/write token (both or neither).
CONTROL_REDIS_URL=
CONTROL_REDIS_TOKEN=
# Private dashboard username is atlas. Use a long random password.
DASHBOARD_TOKEN=
# Initial defaults; saved Telegram preferences take precedence after first startup.
COINS=BTC,ETH,SOL,XRP,ADA,DOGE,LINK,AVAX,DOT,LTC
SCAN_SECONDS=300
LOOKBACK_DAYS=180
ENABLE_WEBSOCKET=true
ENABLE_COINMETRICS=true
ENABLE_DEFILLAMA=true
# Enable only if this provider/product is accessible from your deployment region.
ENABLE_OKX=false
RISK_FREE_ANNUAL=0
DEMO_MODE=false
# Optional path to normalized vendor observations; see docs/EXTERNAL_DATA.md.
EXTERNAL_METRICS_FILE=

# All active listings from these exchanges; separate from the 1–20 coin research watchlist above.
ENABLE_MARKET_UNIVERSE=true
MARKET_EXCHANGES=binance,bitget,bybit,okx
MARKET_TYPES=spot,perpetual
# Per-category rotating requests for Binance OI and OKX funding (0–20).
MARKET_DETAIL_BATCH=10
# CMC uses its documented keyless public API when CMC_API_KEY is empty.
ENABLE_CMC=true
CMC_API_KEY=
# Optional. CoinGlass coins-markets requires an eligible paid API plan.
COINGLASS_API_KEY=
VENDOR_REFRESH_SECONDS=3600
